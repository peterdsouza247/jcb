# ─── Option A: Elastic Cloud (recommended for beginners) ───────────────────
# Sign up at https://cloud.elastic.co (14-day free trial, no credit card)
# After creating a deployment, find your Cloud ID in the deployment overview.
ELASTIC_CLOUD_ID=your-deployment-name:dXMtZWFzdC0xLmF3cy5mb3VuZC5pbwexample==
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=your-password-here

# ─── Option B: Bonsai (free tier, no credit card) ──────────────────────────
# Sign up at https://bonsai.io — free tier gives you 125MB / 10k docs
# ELASTICSEARCH_URL=https://user:password@yourcluster.bonsai.io

# ─── Option C: Local Elasticsearch ─────────────────────────────────────────
# Run locally with Docker: docker run -p 9200:9200 -e "discovery.type=single-node" elasticsearch:8.13.0
# ELASTICSEARCH_URL=http://localhost:9200

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
