# URL of your deployed backend (Railway, Render, Fly.io, etc.)
# For local development, leave as default (http://localhost:3001)
VITE_API_URL=https://your-backend.railway.app

# Set this to your GitHub repo name for GitHub Pages deployment
# e.g. if your repo is github.com/username/comic-catalogue, set this to /comic-catalogue
VITE_BASE_PATH=/comic-catalogue
